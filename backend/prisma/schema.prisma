// SpecialParents.in — Prisma schema
// Covers PRD §11 Core Entities and the Phase 1 MVP feature set,
// designed to extend cleanly into school/IEP, govt schemes, payments etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ──────────────────────────────────────────────────────────

enum Role {
  PARENT
  THERAPIST
  DOCTOR
  TEACHER
  SPECIAL_EDUCATOR
  SCHOOL_ADMIN
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Language {
  EN
  HI
  TE
  TA
  KN
  ML
  BN
  MR
  GU
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  phone             String?        @unique
  passwordHash      String
  fullName          String
  role              Role           @default(PARENT)
  preferredLanguage Language       @default(EN)
  avatarUrl         String?
  isActive          Boolean        @default(true)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // relations
  caregiverLinks    Caregiver[]
  therapistProfile  TherapistProfile?
  authoredSessions  TherapySession[]   @relation("TherapistSessions")
  appointments      Appointment[]      @relation("UserAppointments")
  posts             CommunityPost[]
  comments          CommunityComment[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  aiMessages        AiMessage[]
  invitesSent       ChildInvite[]  @relation("InvitesSent")
  invitesAccepted   ChildInvite[]  @relation("InvitesAccepted")
  behaviorEvents    BehaviorEvent[] @relation("BehaviorEventsLogged")
  authTokens        AuthToken[]
  threadsAsA        MessageThread[] @relation("ThreadParticipantA")
  threadsAsB        MessageThread[] @relation("ThreadParticipantB")
  messagesSent      Message[]       @relation("MessageSender")
  iepApprovals      IepApproval[]   @relation("IepApprovals")
  familyDocuments   FamilyDocument[] @relation("DocumentOwner")
  voiceNotes        VoiceNote[]

  @@index([role])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// A registered practitioner's public-facing profile. Users with role
// THERAPIST / DOCTOR / SPECIAL_EDUCATOR complete this to appear in the
// public /therapists directory. Every profile is reviewed by a platform
// admin before it is visible — education, certifications, and LinkedIn
// are the primary signals the admin checks against.
enum VerificationStatus {
  DRAFT           // therapist is still filling it in
  PENDING_REVIEW  // submitted; sitting in the admin queue
  VERIFIED        // admin approved; listed publicly
  REJECTED        // admin rejected with a note; therapist can revise + resubmit
  SUSPENDED       // previously verified but removed from the directory (complaint, expired credential, etc.)
}

enum ServiceMode {
  ONLINE
  IN_PERSON
  HYBRID
}

// Certification tier — currently modelled after the BACB ladder (ABA
// practitioners). Optional because a SLP / OT / paediatric psychologist
// won't map to this scale. Ordered lowest → highest for display and
// filter defaults.
enum TherapistLevel {
  INTERN   // trainee / student in supervised practicum
  RBT      // Registered Behavior Technician
  BCABA    // Board Certified Assistant Behavior Analyst
  BCBA     // Board Certified Behavior Analyst
}

model TherapistProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Practice basics
  specialization        String              // primary headline specialization ("Speech-Language Pathology")
  specializations       String[]            @default([])  // full list including primary; enables multi-filter
  qualifications        String?             // freeform summary (also captured structurally in TherapistEducation)
  yearsExperience       Int                 @default(0)
  bio                   String?
  hourlyRate            Int?                // INR paise
  languages             String[]            @default([])  // ISO-ish tags: EN, HI, TA, TE, KN, ML, MR, BN, GU
  serviceModes          ServiceMode[]       @default([])
  city                  String?
  state                 String?             // Indian state
  country               String              @default("India")
  photoUrl              String?             // profile photo
  linkedinUrl           String?
  websiteUrl            String?
  availability          String?             // freeform: "Mon–Fri 5–8pm; Sat 10–2"
  acceptingNewClients   Boolean             @default(true)
  ageGroups             String[]            @default([])  // "0-3", "4-7", "8-12", "13-18", "18+"
  level                 TherapistLevel?     // e.g. BCBA / BCaBA / RBT / INTERN — optional; ABA-focused practitioners fill this in

  // Verification workflow — the trust surface of the whole feature.
  verificationStatus    VerificationStatus  @default(DRAFT)
  submittedAt           DateTime?
  verifiedAt            DateTime?           // set when status → VERIFIED
  verifiedById          String?             // admin who acted
  rejectionReason       String?             // shown to the therapist on their own profile
  adminNotes            String?             // internal-only notes for the next reviewer

  educations            TherapistEducation[]
  certifications        TherapistCertification[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([verificationStatus])
  @@index([city, verificationStatus])
}

// Structured education record. The admin cross-checks each row against
// LinkedIn + any uploaded certificate before marking the parent profile
// VERIFIED. Rows can be edited by the therapist any time; a substantive
// change should bump the profile back to PENDING_REVIEW (enforced in the
// service layer).
model TherapistEducation {
  id                  String            @id @default(cuid())
  therapistProfileId  String
  therapistProfile    TherapistProfile  @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  degree              String            // "MSc", "BASLP", "MOT"
  institution         String            // "AIISH Mysuru", "NIEPMD Chennai"
  fieldOfStudy        String?           // "Speech-Language Pathology"
  yearCompleted       Int?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([therapistProfileId])
}

// Structured certification record with optional file upload (goes through
// StorageService like every other file). "RCI registration" is the most
// important one for Indian practitioners — the admin verifies the number
// against the RCI public register.
model TherapistCertification {
  id                    String            @id @default(cuid())
  therapistProfileId    String
  therapistProfile      TherapistProfile  @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  name                  String            // "RCI Registration", "BCBA", "Sensory Integration certification"
  issuingOrganization   String            // "Rehabilitation Council of India"
  credentialId          String?           // registration number
  issueDate             DateTime?
  expiryDate            DateTime?         // for renewable creds; drives suspension reminders
  credentialUrl         String?           // link to the issuer's public register entry
  fileName              String?           // uploaded certificate PDF
  filePath              String?           // storage-backend opaque path
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([therapistProfileId])
}

// ─── Child & Care ──────────────────────────────────────────────────────────

model Child {
  id                  String          @id @default(cuid())
  fullName            String
  dateOfBirth         DateTime
  gender              Gender          @default(PREFER_NOT_TO_SAY)
  photoUrl            String?
  diagnoses           String[]        // free-form tags: "ASD", "ADHD", etc.
  allergies           String[]
  medications         String[]
  sensoryTriggers     String[]
  calmingStrategies   String[]        // what helps regulate: "weighted blanket", "counting"
  hobbies             String[]        // "drawing", "trains", "music"
  communicationType   String?         // "verbal", "AAC", "PECS"

  // School: link to a shared School record (preferred) OR keep the legacy
  // free-text field for children whose school hasn't been created yet.
  schoolId            String?
  school              School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolName          String?         // legacy fallback, still displayed if schoolId is null

  // Sibling grouping — a nullable pointer to a SiblingGroup. Every child in
  // the same group treats the others as siblings. Symmetric by construction.
  siblingGroupId      String?
  siblingGroup        SiblingGroup?   @relation(fields: [siblingGroupId], references: [id], onDelete: SetNull)

  emergencyContact    String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  caregivers          Caregiver[]
  milestones          Milestone[]
  therapySessions     TherapySession[]
  appointments        Appointment[]
  goals               Goal[]
  moodEntries         MoodEntry[]
  diagnosticReports   DiagnosticReport[]
  invites             ChildInvite[]
  behaviorEvents      BehaviorEvent[]
  ieps                Iep[]
  messageThreads      MessageThread[] @relation("MessageThreadChild")
  familyDocuments     FamilyDocument[] @relation("DocumentChild")
  routineSteps        RoutineStep[]

  @@index([fullName])
  @@index([schoolId])
  @@index([siblingGroupId])
}

// ─── Care-team invites ─────────────────────────────────────
// Parent generates a token-based link. Anyone who opens the link
// sees the invite metadata, signs up (or logs in), then accepts.
// Accepting creates a Caregiver row that links them to the child.

model ChildInvite {
  id             String    @id @default(cuid())
  childId        String
  child          Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User      @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  token          String    @unique  // URL-safe random, distributed by the parent
  role           Role      // expected role of the invitee (THERAPIST, DOCTOR, TEACHER, SPECIAL_EDUCATOR, etc.)
  relationship   String    // display label e.g. "primary speech therapist", "pediatrician"
  email          String?   // optional prefilled invitee email
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([childId])
  @@index([token])
}

model DiagnosticReport {
  id             String   @id @default(cuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  fileName       String   // original filename (as uploaded)
  filePath       String   // path relative to backend/uploads/
  fileSize       Int
  mimeType       String
  uploadedById   String?  // nullable so reports survive if user is deleted
  uploadedByName String?  // display snapshot
  createdAt      DateTime @default(now())

  @@index([childId, createdAt])
}

model Caregiver {
  id           String   @id @default(cuid())
  userId       String
  childId      String
  relationship String   // "mother", "father", "guardian", "grandparent"
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([userId, childId])
  @@index([childId])
}

// ─── Development tracking ──────────────────────────────────────────────────

enum MilestoneDomain {
  COMMUNICATION
  SOCIAL
  EMOTIONAL
  MOTOR
  COGNITIVE
  DAILY_LIVING
  SENSORY
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  REGRESSED
}

model Milestone {
  id          String           @id @default(cuid())
  childId     String
  child       Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  domain      MilestoneDomain
  title       String
  description String?
  status      MilestoneStatus  @default(NOT_STARTED)
  achievedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([childId, domain])
}

enum Mood {
  GREAT
  GOOD
  OKAY
  TOUGH
  HARD
}

model MoodEntry {
  id           String     @id @default(cuid())
  childId      String
  child        Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  mood         Mood
  note         String?
  voiceNoteId  String?
  voiceNote    VoiceNote? @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  loggedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([childId, loggedAt])
}

// ─── Behavior events ───────────────────────────────────────────────────────
// A single log for triggers, meltdowns, sleep, food, routine changes — every
// kind of "what happened today?" observation a caregiver wants to record.

enum BehaviorEventKind {
  TRIGGER      // observed sensory / environmental trigger
  MELTDOWN     // full meltdown or dysregulation event
  SLEEP        // bedtime, wake, night waking, nap
  FOOD         // refusal, new food tried, appetite change
  ROUTINE      // routine change or disruption
  OTHER
}

model BehaviorEvent {
  id           String            @id @default(cuid())
  childId      String
  child        Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  loggedById   String?
  loggedBy     User?             @relation("BehaviorEventsLogged", fields: [loggedById], references: [id], onDelete: SetNull)
  kind         BehaviorEventKind
  occurredAt   DateTime          // when the event happened (may differ from createdAt)
  durationMins Int?              // for meltdowns / sleep sessions
  severity     Int?              // 1–5, optional (mostly for meltdowns)
  trigger      String?           // free-form "what triggered it"
  helped       String?           // free-form "what helped"
  note         String?           // additional context
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([childId, occurredAt])
  @@index([childId, kind])
}

// ─── Therapy & Goals ───────────────────────────────────────────────────────

enum TherapyType {
  ABA
  SPEECH
  OCCUPATIONAL
  PHYSIO
  BEHAVIORAL
  SPECIAL_EDUCATION
  OTHER
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model TherapySession {
  id           String         @id @default(cuid())
  childId      String
  child        Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  therapistId  String?
  therapist    User?          @relation("TherapistSessions", fields: [therapistId], references: [id], onDelete: SetNull)
  type         TherapyType
  scheduledAt  DateTime
  durationMins Int            @default(45)
  status       SessionStatus  @default(SCHEDULED)
  notes        String?
  aiSummary    String?
  // IEP goals this session worked on. Loosely referenced (no FK) — an IEP
  // goal deletion won't cascade to strip references from historical sessions.
  // Query with array contains: `where: { iepGoalIds: { has: goalId } }`.
  iepGoalIds   String[]       @default([])
  voiceNoteId  String?
  voiceNote    VoiceNote?     @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([childId, scheduledAt])
  @@index([therapistId, scheduledAt])
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ACHIEVED
  ARCHIVED
}

model Goal {
  id          String      @id @default(cuid())
  childId     String
  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      GoalStatus  @default(ACTIVE)
  targetDate  DateTime?
  progress    Int         @default(0) // 0-100
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([childId, status])
}

// ─── Appointments ──────────────────────────────────────────────────────────

enum AppointmentKind {
  THERAPY
  DOCTOR
  SCHOOL_MEETING
  ASSESSMENT
  OTHER
}

model Appointment {
  id          String           @id @default(cuid())
  childId     String?
  child       Child?           @relation(fields: [childId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("UserAppointments", fields: [userId], references: [id], onDelete: Cascade)
  kind        AppointmentKind  @default(OTHER)
  title       String
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  notes       String?
  reminderAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, startsAt])
  @@index([childId, startsAt])
}

// ─── Community ─────────────────────────────────────────────────────────────

enum PostCategory {
  GENERAL
  SUCCESS_STORY
  QUESTION
  RESOURCE
  REGIONAL
}

model CommunityPost {
  id        String             @id @default(cuid())
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  PostCategory       @default(GENERAL)
  tags      String[]
  pinned    Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  comments  CommunityComment[]

  @@index([category, createdAt])
}

model CommunityComment {
  id        String         @id @default(cuid())
  postId    String
  post      CommunityPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime       @default(now())

  @@index([postId, createdAt])
}

// ─── AI Assistant ──────────────────────────────────────────────────────────

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String   // simple grouping; future: AiThread model
  role      AiRole
  content   String
  createdAt DateTime @default(now())

  @@index([userId, threadId, createdAt])
}

// ─── Notifications & Audit ─────────────────────────────────────────────────

enum NotificationKind {
  REMINDER
  SYSTEM
  COMMUNITY
  THERAPY
  AI
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind  @default(SYSTEM)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // "user.login", "child.create" etc.
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ─── Resources (CMS-lite) ──────────────────────────────────────────────────

model Resource {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  body        String   // markdown
  category    String   // e.g. "autism-guides", "home-therapy"
  language    Language @default(EN)
  coverImage  String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, language])
}

// ─── Family wellness directory ─────────────────────────────────────────────
// Curated third-party offerings that support the whole family — yoga,
// music, art, painting, parent counselling, parent training. Directory-
// style records (title + provider + how to reach them) rather than a
// booking system — parents contact the provider directly. Rows are
// authored by admins via the CMS; the public API is read-only.

enum WellnessCategory {
  YOGA
  MUSIC
  ART
  PAINTING
  PARENT_COUNSELLING
  PARENT_TRAINING
  MEDITATION
  OTHER
}

enum WellnessAudience {
  CHILD      // for the child, often adapted for neurodivergent kids
  PARENT     // for the parent — burnout, self-care, training
  FAMILY     // parent + child together
}

enum WellnessFormat {
  ONLINE
  IN_PERSON
  HYBRID
}

model WellnessOffering {
  id            String           @id @default(cuid())
  category      WellnessCategory
  audience      WellnessAudience
  format        WellnessFormat
  title         String
  provider      String           // "The Yoga Institute — Kids Program"
  description   String
  city          String?          // null when format is ONLINE
  languages     String[]         @default([])
  costHint      String?          // "Free" / "₹500/session" / "₹5,000/month"
  scheduleHint  String?          // "Sat 10am / Wed 5pm"
  contactUrl    String?          // https:// preferred
  contactPhone  String?
  notes         String?          // "First class free", accessibility notes, etc.
  published     Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([category, audience, published])
  @@index([city, published])
}

// ─── Treatments research library ──────────────────────────────────────────
// A curated, evidence-labelled library of treatments and protocols families
// encounter — modern medicine, Ayurveda, Homeopathy, biomedical, cellular
// (incl. stem cell), diet-based, mind-body. Every row carries an EvidenceLevel
// so we never present unproven or harmful therapies as "just another option".
// Editorial standard: neutral tone, references to primary sources, India
// regulatory context (CDSCO, ICMR, AYUSH). NOT a booking directory.

enum TreatmentSystem {
  ALLOPATHIC   // Modern / Western / "English medicine"
  AYURVEDA
  HOMEOPATHY
  NUTRITIONAL  // GFCF, ketogenic, supplements, omega-3
  BIOMEDICAL   // Chelation, HBOT, B12 injections
  CELLULAR     // Stem cell, exosome
  MIND_BODY    // Sensory integration, neurofeedback, behavioural therapies
  OTHER
}

// Editorial rating of the underlying evidence. This is the single most
// important field — the UI treats NOT_RECOMMENDED / EXPERIMENTAL as loud
// warnings, not just chips.
enum EvidenceLevel {
  STANDARD_OF_CARE   // Guideline-backed, first-line
  EMERGING           // Growing evidence, promising but not established
  LIMITED            // Some studies, weak/mixed evidence
  EXPERIMENTAL       // Research phase only; only pursue in registered trials
  NOT_RECOMMENDED    // Evidence against, or harm risk > benefit
}

enum TreatmentFocus {
  CORE_SYMPTOMS   // Attempts to change core autism features
  COMORBIDITY     // ADHD, epilepsy, GI, anxiety, sleep
  SYMPTOM_RELIEF  // Irritability, aggression, sleep-onset
  SUPPORT         // General wellbeing / caregiver-oriented
}

model TreatmentResearch {
  id                   String           @id @default(cuid())
  system               TreatmentSystem
  focus                TreatmentFocus
  evidenceLevel        EvidenceLevel
  // Titles are curated and human-authored; unique so re-seeds
  // (nest --watch restarts, admin re-runs) are idempotent.
  title                String           @unique
  alsoKnownAs          String?          // brand names / synonyms
  summary              String           // 2–3 sentences, plain English
  whatItIs             String
  whatResearchShows    String
  considerations       String           // side effects, monitoring, cautions
  indiaContext         String?          // CDSCO/ICMR/AYUSH status, cost/access
  references           String[]         @default([])
  prescriptionRequired Boolean          @default(false)
  published            Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([system, published])
  @@index([evidenceLevel, published])
  @@index([focus, published])
}

// ─── Government Schemes (lightweight scaffold) ─────────────────────────────

model GovernmentScheme {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String
  benefitSummary  String?
  eligibility     String?
  applyUrl        String?
  states          String[]
  language        Language @default(EN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── IEP (Individualized Education Program) ────────────────────────────────
// A living document that captures a child's present levels of performance,
// annual goals, accommodations, related services (therapies), and review
// history. In India this is usually built with the school's special educator
// + the therapy team + the parent, and revisited every quarter.

enum IepStatus {
  DRAFT           // still being written
  PENDING_REVIEW  // author submitted; awaiting signatures from care team
  ACTIVE          // signed off and in effect
  ARCHIVED        // superseded by a newer IEP or the school year ended
}

model Iep {
  id             String     @id @default(cuid())
  childId        String
  child          Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  schoolYear     String     // "2026-2027"
  title          String?    // optional label, e.g. "Grade 3 IEP"
  status         IepStatus  @default(DRAFT)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?

  presentLevels  String?    // free-form summary of current academic + functional level
  strengths      String?
  concerns       String?

  // Simple string list — "extra time for tests", "seat near teacher".
  accommodations String[]

  // Richer array of related services: each item is
  // { type: TherapyType, frequency: string, provider: string, setting: string }
  services       Json[]     @default([])

  createdById    String?
  createdByName  String?    // snapshot in case the user is removed later

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  goals          IepGoal[]
  reviews        IepReview[]
  approvals      IepApproval[]

  @@index([childId, status])
  @@index([childId, schoolYear])
}

// A signature on an IEP. One row per (iep, user); a user unsigns by
// deleting their row. Once every required signer (see IepService.canPublish)
// has approved, the IEP auto-transitions PENDING_REVIEW → ACTIVE.

model IepApproval {
  id        String   @id @default(cuid())
  iepId     String
  iep       Iep      @relation(fields: [iepId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("IepApprovals", fields: [userId], references: [id], onDelete: Cascade)
  role      Role     // captured at time of signing (a role change later shouldn't invalidate history)
  note      String?
  signedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([iepId, userId])
  @@index([iepId])
}

model IepGoal {
  id                 String           @id @default(cuid())
  iepId              String
  iep                Iep              @relation(fields: [iepId], references: [id], onDelete: Cascade)
  domain             MilestoneDomain
  title              String
  description        String?
  measurableCriteria String?          // "reads 40 wpm from a grade-2 text with 90% accuracy"
  targetDate         DateTime?
  status             MilestoneStatus  @default(NOT_STARTED)
  progress           Int              @default(0) // 0-100

  // Lineage: when this goal was created via the "carry over" action from a
  // previous year's IEP, this points back to the source goal so progress
  // history stays traceable.
  carriedOverFromId  String?
  carriedOverFrom    IepGoal?         @relation("GoalCarryover", fields: [carriedOverFromId], references: [id], onDelete: SetNull)
  carriedInto        IepGoal[]        @relation("GoalCarryover")

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([iepId])
  @@index([carriedOverFromId])
}

// ─── Auth tokens (password reset + email verification) ────────────────────
// Single table, single flow. Tokens are single-use: consumed = usedAt set,
// and we always verify usedAt IS NULL + expiresAt > now() before honoring.

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AuthTokenType
  tokenHash  String        @unique // SHA-256 of the raw token; raw token never persisted
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime      @default(now())

  @@index([userId, type])
}

model IepReview {
  id           String   @id @default(cuid())
  iepId        String
  iep          Iep      @relation(fields: [iepId], references: [id], onDelete: Cascade)
  reviewDate   DateTime
  notes        String?
  participants String[] // list of names present at the review
  createdAt    DateTime @default(now())

  @@index([iepId, reviewDate])
}

// ─── Voice notes ───────────────────────────────────────────────────────────
// Short audio clips a parent or therapist records via MediaRecorder, then
// (optionally) auto-transcribed by Whisper. Multiple records can link to
// the same VoiceNote — a mood entry uses one to describe the day, a
// therapy session uses one to capture verbal notes. Ownership tracked by
// `userId`; access checked at the streaming endpoint.

model VoiceNote {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storagePath  String            // opaque StorageService path
  fileSize     Int
  mimeType     String
  durationSec  Int?
  transcript   String?
  createdAt    DateTime @default(now())

  moodEntries       MoodEntry[]
  therapySessions   TherapySession[]

  @@index([userId, createdAt])
}

// ─── Daily routine (per-child visual schedule) ────────────────────────────
// Visual schedules are foundational scaffolding for autistic + ADHD kids:
// each step of the day is a card with a picture, a time, and a category.
// The child can be walked through them; parents can edit any time.
//
// timeOfDay is stored as a "HH:MM" string in 24h. Simpler than DateTime for
// a schedule that repeats — no timezone drift, no date arithmetic.
// daysOfWeek: 0-6 (Sun-Sat). Empty array means "every day".

enum RoutineCategory {
  SELF_CARE    // brush teeth, toilet, bath, hair
  MEAL         // breakfast, lunch, dinner, snack
  SCHOOL       // school time, homework
  THERAPY      // therapy sessions
  PLAY         // free play, outdoor, screen time
  SLEEP        // nap, bedtime, wake up
  LEARNING     // reading, practice
  CHORE        // help around the house
  OTHER
}

model RoutineStep {
  id            String           @id @default(cuid())
  childId       String
  child         Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  icon          String           // emoji, e.g. "🪥"
  category      RoutineCategory
  timeOfDay     String           // "06:15" — HH:MM 24h
  durationMins  Int?
  daysOfWeek    Int[]            @default([]) // empty = every day
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([childId, timeOfDay])
  @@index([childId, active])
}

// ─── Family documents vault ────────────────────────────────────────────────
// Where families keep the paperwork that travels with them everywhere:
// UDID card, Niramaya card, disability certificate, medical letters,
// school reports, IEP snapshots. Scoped to a user (owner) with an optional
// childId when the document belongs to a specific child. Uses the shared
// StorageService for the underlying file, so Cloudinary swap-in is free.

enum FamilyDocumentType {
  UDID              // Unique Disability ID card
  DISABILITY_CERT   // government disability certificate
  NIRAMAYA          // Niramaya insurance card / policy
  MEDICAL_REPORT    // doctor letters, prescriptions
  SCHOOL_REPORT     // report cards, progress reports
  IEP_SNAPSHOT      // exported / printed IEP
  IDENTITY          // Aadhaar (masked), PAN, passport of the child
  OTHER
}

model FamilyDocument {
  id            String              @id @default(cuid())
  ownerId       String
  owner         User                @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  childId       String?
  child         Child?              @relation("DocumentChild", fields: [childId], references: [id], onDelete: SetNull)
  type          FamilyDocumentType
  title         String
  notes         String?
  fileName      String
  filePath      String              // opaque StorageService path
  fileSize      Int
  mimeType      String
  expiresAt     DateTime?           // e.g. UDID renewal date, insurance expiry — surfaced in reminders
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([ownerId, type])
  @@index([childId, type])
  @@index([ownerId, expiresAt])
}

// ─── School (first-class entity) ───────────────────────────────────────────
// Multiple children can share the same school. Metadata lives here instead
// of being duplicated as a free-text field on each Child row. The old
// Child.schoolName remains as a fallback for children not yet linked.

enum SchoolBoard {
  CBSE
  ICSE
  STATE
  IB
  IGCSE
  NIOS
  OTHER
}

model School {
  id             String       @id @default(cuid())
  name           String
  board          SchoolBoard  @default(OTHER)
  city           String?
  state          String?
  address        String?
  principalName  String?
  contactEmail   String?
  contactPhone   String?
  website        String?
  isInclusive    Boolean      @default(false) // has a resource room / special educator
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  children       Child[]

  @@index([name])
  @@index([city, state])
}

// ─── Sibling groups ────────────────────────────────────────────────────────
// A single SiblingGroup row groups two or more Children. Each Child.siblingGroupId
// points to the same group. Membership is symmetric by construction — adding
// child B to child A's group makes them siblings both ways.

model SiblingGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  children  Child[]
}

// ─── Messaging (parent ↔ therapist) ────────────────────────────────────────
// 1:1 threads today. Every thread has exactly two participants; participantA
// is always the user with the lexicographically smaller id, which gives us a
// unique index so opening a thread with the same person twice returns the
// existing one. An optional childId scopes the thread to a specific child.

model MessageThread {
  id             String    @id @default(cuid())
  participantAId String
  participantA   User      @relation("ThreadParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId String
  participantB   User      @relation("ThreadParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  childId        String?
  child          Child?    @relation("MessageThreadChild", fields: [childId], references: [id], onDelete: SetNull)
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  messages       Message[]

  @@unique([participantAId, participantBId, childId])
  @@index([participantAId, lastMessageAt])
  @@index([participantBId, lastMessageAt])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  readAt    DateTime?     // set when the recipient loads the thread
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([threadId, readAt])
}
