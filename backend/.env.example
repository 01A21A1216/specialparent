# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://specialparent:specialparent@localhost:5432/specialparent?schema=public

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_REFRESH_TTL=604800

# ─── AI (optional — leave empty to use mock responses) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
